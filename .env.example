# Copy to .env.local (git-ignored) and adjust for your environment.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put secrets here; anything in this file ships to the client.

# Base URL of the TL-Chat-Backend (REST API + SignalR /chathub)
VITE_BACKEND_URL=http://localhost:5000

# Builds ALWAYS require an https:// VITE_BACKEND_URL — an http:// or unset value fails the
# build, with no override (every `vite build` is a production build). For local development
# against an http backend, use the dev server (`npm run dev`), which is not subject to this guard.

# Build-time toggles (read by scripts/obfuscate.mjs, not by the browser)
# OBFUSCATE=1        -> run javascript-obfuscator over dist/ after `vite build`

# Standalone demo mode: in-memory scripted hub + REST stub, no backend needed (dev only)
# VITE_DEMO_MODE=true
